{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**",
              "!node:*",
              "!./**",
              "!../**",
              "**/node_modules/**"
            ],
            "message": "this directory has no package.json, so it takes no npm package: Node built-ins and repository files only (docs/quality/gates.md → Dependencies)"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
