{
  "name": "csr-dev-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm wasm:build:dev && vite --port 5173",
    "build": "pnpm wasm:build && tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "wasm:build": "cd wasm && ./scripts/build.sh",
    "wasm:build:dev": "cd wasm && ./scripts/build.sh --dev",
    "wasm:test": "cd wasm && cargo test"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@huggingface/transformers": "4.3.1",
    "@lezer/highlight": "1.2.5",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-toast": "1.2.24",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-router": "1.170.42",
    "@uiw/codemirror-themes": "4.25.12",
    "@uiw/react-codemirror": "4.25.12",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "dompurify": "3.4.16",
    "graphql": "17.0.2",
    "jsonpath-plus": "11.2.0",
    "jszip": "3.10.2",
    "mermaid": "12.1.0",
    "motion": "14.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-image-crop": "11.1.2",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64",
        "x64"
      ]
    }
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.5.0"
  },
  "sideEffects": false
}