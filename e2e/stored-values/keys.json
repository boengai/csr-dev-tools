      "key": "csr-dev-tools-jsonpath-evaluator",
      "owner": "jsonpath-evaluator",
      "reader": "migration-source",
      "format": "json",
      "legacy": true,
      "written": "only to put the old value back when the -v2 write fails",
      "note": "{expression, jsonInput}. Moved to …-jsonpath-evaluator-v2 when that key is absent and the value is neither junk nor the default, then deleted."
    }
