      "owner": "mermaid-renderer",
      "reader": "migration-source",
      "format": "json",
      "legacy": true,
      "written": false,
      "note": "A JSON string. When …-mermaid-renderer is absent, a string moves there as {source}, any other JSON value is dropped, and the old key is deleted. Unparseable text is left in place."
    },
