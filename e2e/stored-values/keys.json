  "patterns": [
    {
      "name": "codec-mode",
      "pattern": "csr-dev-tools-<modeStorageKey>-mode",
      "note": "A Codec tool's mode, a JSON string. Must be one of the tool's modes, or the first mode opens."
    },
    {
      "name": "codec-source",
      "pattern": "csr-dev-tools-[<sourceKeyPrefix>-]<mode>-source",
      "note": "A Codec tool's source for one mode, a JSON string."
    },
    {
      "name": "handoff",
      "pattern": "csr-dev-tools-handoff-<channel>",
      "note": "A cross-tool handoff, raw text. The only channel is mermaid-renderer."
    }
  ],
